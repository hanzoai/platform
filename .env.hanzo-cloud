# Hanzo Cloud Integration Configuration
# Copy this file to .env and configure for your environment

# ===== HANZO CLOUD INTEGRATION =====
# Enable Hanzo Cloud features (project launcher mode)
HANZO_CLOUD_ENABLED=true
IS_CLOUD=true

# Hanzo Cloud API Configuration
HANZO_CLOUD_API_URL=https://api.hanzo.ai
HANZO_CLOUD_API_KEY=your-hanzo-cloud-api-key
HANZO_CLOUD_CONSOLE_URL=https://console.hanzo.ai

# Shared Authentication with Hanzo Cloud Console
HANZO_SHARED_AUTH=true
IAM_CLIENT_ID=your-client-id
IAM_CLIENT_SECRET=your-client-secret

# ===== EXISTING PLATFORM CONFIGURATION =====
# Better Auth Configuration (shared with Hanzo Cloud)
BETTER_AUTH_URL=https://auth.hanzo.ai
BETTER_AUTH_SECRET=your-better-auth-secret

# Database Configuration (can be shared with Hanzo Cloud console)
DATABASE_URL=postgresql://postgres:password@localhost:5432/platform
REDIS_URL=redis://localhost:6379

# Platform API Configuration
PLATFORM_API_URL=http://localhost:3000
PLATFORM_API_KEY=your-platform-api-key

# Traefik Configuration (for local deployments)
TRAEFIK_API_URL=http://localhost:8080
DOMAIN=platform.hanzo.ai

# ===== DEPLOYMENT REGIONS =====
# Default deployment region for Hanzo Cloud
DEFAULT_REGION=us-west-1

# Available regions (comma-separated)
AVAILABLE_REGIONS=us-west-1,us-east-1,eu-west-1,ap-northeast-1

# ===== MONITORING & ANALYTICS =====
# DataDog integration for Hanzo Cloud deployments
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key

# ===== CDN CONFIGURATION =====
# Cloudflare integration for static assets
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id

# ===== BACKUP CONFIGURATION =====
# S3-compatible storage for backups
BACKUP_S3_ENDPOINT=https://s3.amazonaws.com
BACKUP_S3_BUCKET=hanzo-platform-backups
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key

# ===== WEBHOOK ENDPOINTS =====
# Webhook secret for validating deployment events
WEBHOOK_SECRET=your-webhook-secret

# ===== FEATURE FLAGS =====
# Enable specific features for Hanzo Cloud mode
ENABLE_AUTO_SCALING=true
ENABLE_CDN=true
ENABLE_MONITORING=true
ENABLE_BACKUP=true
ENABLE_MULTI_REGION=true

# ===== LOCAL DEVELOPMENT =====
# For local testing of cloud features
LOCAL_CLOUD_MODE=false
MOCK_CLOUD_API=false