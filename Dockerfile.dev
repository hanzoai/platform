FROM node:20.16.0-alpine

# Install system dependencies
RUN apk add --no-cache libc6-compat git python3 make g++ bash

# Set working directory
WORKDIR /app

# Install pnpm directly via npm
RUN npm install -g pnpm@10.5.2

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY app/hanzo/package.json ./app/hanzo/
COPY pkg/*/package.json ./pkg/*/

# Install dependencies
RUN pnpm install --no-frozen-lockfile --ignore-scripts

# Copy application code
COPY . .

# Build the application (ignore TypeScript errors for now)
RUN pnpm build || true

# Build Next.js app specifically
WORKDIR /app/app/hanzo
RUN pnpm build || true

# Expose port
EXPOSE 3000

# Start the application
CMD ["pnpm", "start"]