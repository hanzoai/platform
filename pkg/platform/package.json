{
  "name": "@hanzo/platform",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./package.json": "./package.json",
    "./constants": "./dist/constants/index.js",
    "./db": "./dist/db/index.js",
    "./db/schema": "./dist/db/schema/index.js",
    "./db/schema/*": "./dist/db/schema/*.js",
    "./lib/auth": "./dist/lib/auth.js",
    "./services/ci": "./dist/services/ci/index.js",
    "./services/*": "./dist/services/*.js",
    "./templates/*": "./dist/templates/*.js",
    "./utils/*": "./dist/utils/*.js",
    "./utils/ai/*": "./dist/utils/ai/*.js",
    "./utils/backups/*": "./dist/utils/backups/*.js",
    "./utils/process/*": "./dist/utils/process/*.js",
    "./utils/restore": "./dist/utils/restore/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "npm run switch:prod && rimraf dist && tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "build:types": "tsc --emitDeclarationOnly --experimenta-dts",
    "switch:dev": "node scripts/switchToSrc.js",
    "switch:prod": "node scripts/switchToDist.js",
    "dev": "rimraf dist && pnpm esbuild && tsc --emitDeclarationOnly --outDir dist -p tsconfig.server.json",
    "esbuild": "tsx ./esbuild.config.ts && tsc --project tsconfig.server.json --emitDeclarationOnly ",
    "typecheck": "tsc --noEmit",
    "dbml:generate": "npx tsx src/db/schema/dbml.ts",
    "generate:drizzle": "pnpm dlx  @better-auth/cli generate --output auth-schema2.ts --config src/lib/auth.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/azure": "^3.0.76",
    "@ai-sdk/cohere": "^3.0.39",
    "@ai-sdk/deepinfra": "^2.0.55",
    "@ai-sdk/mistral": "^3.0.40",
    "@ai-sdk/openai": "^3.0.73",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@better-auth/sso": "1.5.0-beta.16",
    "@better-auth/utils": "0.3.1",
    "@faker-js/faker": "^8.4.1",
    "@hanzo/iam": "^0.13.1",
    "@kubernetes/client-node": "^1.4.0",
    "@octokit/auth-app": "^6.1.4",
    "@octokit/rest": "^20.1.2",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@react-email/components": "^0.0.21",
    "@trpc/server": "11.10.0",
    "adm-zip": "^0.5.17",
    "ai": "^6.0.208",
    "ai-sdk-ollama": "^3.8.8",
    "bcrypt": "5.1.1",
    "better-auth": "1.5.0-beta.16",
    "better-call": "1.3.2",
    "bl": "6.0.11",
    "boxen": "^7.1.1",
    "date-fns": "3.6.0",
    "dockerode": "4.0.2",
    "dotenv": "16.4.5",
    "better-sqlite3": "12.11.1",
    "drizzle-dbml-generator": "0.10.0",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.5.1",
    "lodash": "4.17.21",
    "micromatch": "4.0.8",
    "nanoid": "3.3.11",
    "node-os-utils": "2.0.1",
    "node-pty": "1.1.0",
    "node-schedule": "2.1.1",
    "nodemailer": "6.9.14",
    "octokit": "3.1.2",
    "pino": "9.4.0",
    "pino-pretty": "11.2.2",
    "public-ip": "6.0.2",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "resend": "^6.14.0",
    "semver": "7.7.3",
    "shell-quote": "^1.8.4",
    "slugify": "^1.6.9",
    "ssh2": "1.17.0",
    "toml": "3.0.0",
    "ws": "8.16.0",
    "yaml": "2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/cli": "1.5.0-beta.13",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "5.0.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/dockerode": "3.3.23",
    "@types/lodash": "4.17.4",
    "@types/micromatch": "4.0.9",
    "@types/node": "^24.13.2",
    "@types/node-schedule": "2.1.6",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@types/semver": "7.7.1",
    "@types/shell-quote": "^1.7.5",
    "@types/ssh2": "1.15.1",
    "@types/ws": "8.5.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.20.2",
    "esbuild-plugin-alias": "0.2.1",
    "postcss": "^8.5.15",
    "rimraf": "6.1.3",
    "tsc-alias": "1.8.10",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "^24.4.0",
    "pnpm": ">=10.22.0"
  }
}