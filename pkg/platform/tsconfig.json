{
	"compilerOptions": {
		/* Base Options: */
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		/* Strictness */
		"strict": false,
		"noUncheckedIndexedAccess": false,
		"checkJs": false,
		"noImplicitAny": false,
		"strictNullChecks": false,
		/* Bundled projects */
		"lib": ["dom", "dom.iterable", "ES2022"],
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"plugins": [{ "name": "next" }],
    "outDir": "./dist",
		"paths": {
			"@hanzo/platform/*": ["./src/*"]
		}
	},
	"include": ["next-env.d.ts", "./src/**/*.ts"],

	"exclude": [
		"tsup.ts",
		"node_modules",
		"platform",
		"config",
		"dist",
		".next",
		"webpack.config.server.js",
		"migration.ts",
		"setup.ts"
	]
}
