# Hanzo API Configuration
HANZO_URL=https://your-hanzo-instance.com
HANZO_API_KEY=your-api-key-here
HANZO_AUTH_TOKEN=your_token_here

# Docker Compose Configuration
# Transport mode: http, sse, or stdio
MCP_TRANSPORT=http

# External port mapping (container always uses 3000 internally)
EXTERNAL_PORT=3000
