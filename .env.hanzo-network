# Hanzo Network Configuration
# EVM Chain deployment configuration

# ===== HANZO NETWORK (EVM CHAIN) =====
HANZO_NETWORK_ENDPOINT=https://api.hanzo.network
HANZO_NETWORK_PRIVATE_KEY=your-deployment-wallet-private-key
HANZO_NETWORK_CHAIN_ID=36963  # Mainnet: 36963, Localhost: 1337

# ===== IAM (AUTHENTICATION) =====
IAM_ENDPOINT=https://iam.hanzo.ai
IAM_CLIENT_ID=platform
IAM_CLIENT_SECRET=your-client-secret

# ===== DATABASE =====
DATABASE_URL=postgresql://postgres:password@localhost:5432/platform
REDIS_URL=redis://localhost:6379

# ===== PLATFORM =====
NEXT_PUBLIC_APP_URL=https://platform.hanzo.ai
NODE_ENV=production

# ===== COMPOSE SPEC STORAGE =====
COMPOSE_STORAGE_PATH=/var/lib/hanzo/compose

# ===== MONITORING =====
TELEMETRY_ENDPOINT=https://telemetry.hanzo.network

# ===== FEATURE FLAGS =====
ENABLE_COMPOSE_EDITOR=true
ENABLE_NETWORK_DEPLOY=true
ENABLE_IAM_AUTH=true