{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@hanzo/platform": ["../../pkg/platform/src/index.ts"],
			"@hanzo/platform/*": ["../../pkg/platform/src/*"]
		}
	},
	"exclude": ["node_modules", "dist"],
	"include": ["src/**/*"]
}
