FROM node:22-alpine

# Install build dependencies for native modules
RUN apk add --no-cache python3 make g++ linux-headers

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy package files first for better caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY pkg/core/package.json pkg/core/
COPY app/hanzo/package.json app/hanzo/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY . .

# Build core package first (skip TypeScript checking)
WORKDIR /app/pkg/core
RUN npx tsc --noEmit false --skipLibCheck || true && pnpm run build || pnpm run dev:set

# Build the application
WORKDIR /app/app/hanzo
RUN pnpm run build

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV IS_CLOUD=false
ENV DATABASE_URL=postgresql://postgres:postgres@172.17.0.1:5432/platform
ENV REDIS_URL=redis://172.17.0.1:6379

EXPOSE 3000

# Start the application
CMD ["pnpm", "run", "start"]