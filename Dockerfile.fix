FROM node:20-alpine AS base

# Install dependencies including Python for bcrypt
RUN apk add --no-cache libc6-compat openssl git curl python3 make g++

WORKDIR /app

# Copy all source files
COPY . .

# Install dependencies and rebuild native modules
RUN npm install -g pnpm@9.12.3 && \
    pnpm install --frozen-lockfile

# Build the application
WORKDIR /app/app/platform
RUN pnpm run build

# Production stage
FROM node:20-alpine AS runner
WORKDIR /app

RUN apk add --no-cache openssl git curl

# Copy entire node_modules from monorepo root
COPY --from=base /app/node_modules /app/node_modules

# Copy the @hanzo/platform package
COPY --from=base /app/pkg/platform /app/pkg/platform

# Copy built application
COPY --from=base /app/app/platform/package.json ./app/platform/
COPY --from=base /app/app/platform/dist ./app/platform/dist
COPY --from=base /app/app/platform/.next ./app/platform/.next
COPY --from=base /app/app/platform/public ./app/platform/public
COPY --from=base /app/app/platform/pages ./app/platform/pages
COPY --from=base /app/app/platform/drizzle ./app/platform/drizzle
COPY --from=base /app/app/platform/components.json ./app/platform/components.json
COPY --from=base /app/app/platform/next.config.mjs ./app/platform/next.config.mjs
COPY --from=base /app/app/platform/node_modules ./app/platform/node_modules

# Copy workspace files
COPY --from=base /app/pnpm-workspace.yaml ./
COPY --from=base /app/package.json ./

WORKDIR /app/app/platform

# Set environment
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

EXPOSE 3000

CMD ["node", "dist/server.mjs"]