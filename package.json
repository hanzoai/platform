{
  "name": "@hanzo/platform-monorepo",
  "private": true,
  "workspaces": [
    "app/*",
    "pkg/*"
  ],
  "scripts": {
    "platform:setup": "pnpm --filter=@hanzo/platform-app run setup",
    "platform:dev": "pnpm --filter=@hanzo/platform-app run dev",
    "platform:build": "pnpm --filter=@hanzo/platform-app run build",
    "platform:start": "pnpm --filter=@hanzo/platform-app run start",
    "test": "pnpm --filter=@hanzo/platform-app run test",
    "server:script": "pnpm --filter=@hanzo/platform run switch:dev",
    "server:dev": "pnpm --filter=@hanzo/platform run dev",
    "server:build": "pnpm --filter=@hanzo/platform run build",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "format-and-lint": "biome check .",
    "check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "format-and-lint:fix": "biome check . --write",
    "generate:openapi": "pnpm --filter=@hanzo/platform-app run generate:openapi"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "esbuild": "catalog:",
    "lint-staged": "catalog:",
    "tsx": "catalog:"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "^24.4.0",
    "pnpm": ">=9.12.0"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "resolutions": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
