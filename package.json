{
	"name": "platform",
	"private": true,
	"workspaces": ["app/*", "pkg/*"],
	"scripts": {
		"platform:setup": "pnpm --filter=platform run setup",
		"platform:dev": "pnpm --filter=platform run dev",
		"platform:dev:turbopack": "pnpm --filter=platform run dev-turbopack",
		"platform:build": "pnpm --filter=platform run build",
		"platform:start": "pnpm --filter=platform run start",
		"test": "pnpm --filter=platform run test",
		"server:script": "pnpm --filter=server run switch:dev",
		"server:dev": "pnpm --filter=server run dev",
		"server:build": "pnpm --filter=server run build",
		"docker:build:canary": "./app/hanzo/docker/build.sh canary",
		"typecheck": "pnpm -r run typecheck",
		"build": "pnpm -r run build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^18.17.0",
		"dotenv": "16.4.5",
		"esbuild": "0.20.2",
		"lefthook": "1.8.4",
		"lint-staged": "^15.2.7",
		"tsx": "4.16.2"
	},
	"packageManager": "pnpm@10.4.1",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"core-js",
			"core-js-pure",
			"sharp",
			"tree-sitter",
			"tree-sitter-json",
			"tree-sitter-yaml"
		]
	}
}
