{
	"name": "hanzo-platform",
	"private": true,
	"version": "4.0.4",
	"workspaces": ["app/*", "pkg/*"],
	"scripts": {
		"cloud:setup": "pnpm --filter=cloud run setup",
		"cloud:dev": "pnpm --filter=cloud run dev",
		"cloud:dev:turbopack": "pnpm --filter=cloud run dev-turbopack",
		"cloud:build": "pnpm --filter=cloud run build",
		"cloud:start": "pnpm --filter=cloud run start",
		"start": "pnpm --filter=cloud run start",
		"test": "pnpm --filter=cloud run test",
		"core:script": "pnpm --filter=core run switch:dev",
		"core:dev": "pnpm --filter=core run dev",
		"core:build": "pnpm --filter=core run build",
		"docker:build:base": "docker buildx build --platform linux/amd64,linux/arm64 -f docker/base/Dockerfile -t hanzoai/os:latest --push .",
		"docker:build:canary": "./docker/build.sh canary",
		"docker:build:production": "./docker/build.sh production",
		"docker:build:platform": "docker build -f docker/platform/Dockerfile -t hanzoai/platform:latest --push .",
		"docker:update:platform": "docker pull hanzoai/platform:latest && docker service update --image hanzoai/platform:latest platform",
		"typecheck": "pnpm -r run typecheck",
		"build": "pnpm -r run build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write"
	},
	"devDependencies": {
		"dotenv": "16.4.5",
		"esbuild": "0.20.2",
		"tsx": "4.16.2",
		"lint-staged": "^15.2.7",
		"@biomejs/biome": "1.9.4",
		"lefthook": "1.8.4",
		"@commitlint/cli": "^19.3.0",
		"@commitlint/config-conventional": "^19.2.2",
		"@types/node": "^18.17.0"
	},
	"packageManager": "pnpm@10.5.2",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"bcrypt",
			"core-js",
			"core-js-pure",
			"cpu-features",
			"esbuild",
			"lefthook",
			"msgpackr-extract",
			"node-pty",
			"sharp",
			"sqlite3",
			"ssh2",
			"tree-sitter",
			"tree-sitter-json",
			"tree-sitter-yaml"
		]
	}
}
