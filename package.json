{
	"name": "hanzo-platform",
	"private": true,
	"workspaces": [
		"app/*",
		"pkg/*"
	],
	"scripts": {
		"cloud:setup": "pnpm --filter=cloud run setup",
		"cloud:dev": "pnpm --filter=cloud run dev",
		"cloud:dev:turbopack": "pnpm --filter=cloud run dev-turbopack",
		"cloud:build": "pnpm --filter=cloud run build",
		"cloud:start": "pnpm --filter=cloud run start",
		"test": "pnpm --filter=cloud run test",
		"platform:script": "pnpm --filter=platform run switch:dev",
		"platform:dev": "pnpm --filter=platform run dev",
		"platform:build": "pnpm --filter=platform run build",
		"docker:build:canary": "./docker/build.sh",
		"docker:build:prod": "./docker/build.sh prod",
		"typecheck": "pnpm -r run typecheck",
		"build": "pnpm -r run build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^18.17.0",
		"dotenv": "16.4.5",
		"esbuild": "0.20.2",
		"lefthook": "1.8.4",
		"lint-staged": "^15.2.7",
		"tsx": "4.16.2"
	},
	"packageManager": "pnpm@10.4.1",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"bcrypt",
			"core-js",
			"core-js-pure",
			"cpu-features",
			"esbuild",
			"lefthook",
			"msgpackr-extract",
			"node-pty",
			"sharp",
			"sqlite3",
			"ssh2",
			"tree-sitter",
			"tree-sitter-json",
			"tree-sitter-yaml"
		]
	}
}
