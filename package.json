{
	"name": "hanzo-platform",
	"private": true,
	"version": "4.0.6",
	"workspaces": [
		"app/*",
		"pkg/*"
	],
	"scripts": {
		"hanzo:setup": "pnpm --filter=hanzo run setup",
		"hanzo:dev": "pnpm --filter=hanzo run dev",
		"hanzo:dev:turbopack": "pnpm --filter=hanzo run dev-turbopack",
		"hanzo:build": "pnpm --filter=hanzo run build",
		"hanzo:start": "pnpm --filter=hanzo run start",
		"start": "pnpm --filter=hanzo run start",
		"test": "pnpm --filter=hanzo run test",
		"core:script": "pnpm --filter=core run switch:dev",
		"core:dev": "pnpm --filter=core run dev",
		"core:build": "pnpm --filter=core run build",
		"docker:build:base": "docker buildx build --platform linux/amd64,linux/arm64 -f docker/base/Dockerfile -t hanzoai/os:latest --push .",
		"docker:build:canary": "./docker/build.sh canary",
		"docker:build:production": "./docker/build.sh production",
		"docker:build:platform": "docker build -f docker/hanzo/Dockerfile -t hanzoai/platform:latest --push .",
		"docker:build:dev": "docker build -f docker/dev/Dockerfile -t hanzoai/platform:dev --push .",
		"docker:update:hanzo": "docker pull hanzoai/platform:latest && docker service update --image hanzoai/platform:latest hanzo",
		"typecheck": "pnpm -r run typecheck",
		"build": "pnpm -r run build",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@commitlint/cli": "^19.3.0",
		"@commitlint/config-conventional": "^19.2.2",
		"@types/node": "^18.17.0",
		"dotenv": "16.4.5",
		"esbuild": "0.20.2",
		"lefthook": "1.8.4",
		"lint-staged": "^15.2.7",
		"tsx": "4.16.2"
	},
	"packageManager": "pnpm@10.5.2",
	"engines": {
		"node": ">=22",
		"pnpm": ">=10"
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"core-js",
			"core-js-pure",
			"cpu-features",
			"esbuild",
			"lefthook",
			"msgpackr-extract",
			"node-pty",
			"sharp",
			"sqlite3",
			"ssh2",
			"tree-sitter",
			"tree-sitter-json",
			"tree-sitter-yaml"
		]
	},
	"dependencies": {
		"pino": "9.4.0",
		"toml": "^3.0.0"
	}
}
