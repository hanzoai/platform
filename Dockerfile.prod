FROM node:22-alpine AS base
RUN apk add --no-cache python3 make g++ linux-headers libc6-compat git
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY pkg/core/package.json pkg/core/
COPY app/hanzo/package.json app/hanzo/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --include-workspace-root

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN cd pkg/core && pnpm run build
RUN cd app/hanzo && pnpm run build

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV IS_CLOUD=false
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=nextjs:nodejs /app/pkg ./pkg
COPY --from=builder --chown=nextjs:nodejs /app/app/hanzo/.next ./app/hanzo/.next
COPY --from=builder --chown=nextjs:nodejs /app/app/hanzo/dist ./app/hanzo/dist
COPY --from=builder --chown=nextjs:nodejs /app/app/hanzo/public ./app/hanzo/public
COPY --from=builder --chown=nextjs:nodejs /app/app/hanzo/package.json ./app/hanzo/
COPY --from=builder --chown=nextjs:nodejs /app/app/hanzo/server ./app/hanzo/server
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/app/hanzo/node_modules ./app/hanzo/node_modules

USER nextjs

EXPOSE 3000

CMD ["pnpm", "run", "hanzo:start"]
