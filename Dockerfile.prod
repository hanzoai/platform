# syntax=docker/dockerfile:1
FROM node:20.16.0-slim
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
RUN corepack prepare pnpm@9.12.0 --activate

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl unzip zip apache2-utils iproute2 rsync git-lfs \
    python3 make g++ git python3-pip pkg-config libsecret-1-dev \
    && git lfs install \
    && rm -rf /var/lib/apt/lists/*

# Install docker
RUN curl -fsSL https://get.docker.com -o get-docker.sh && sh get-docker.sh && rm get-docker.sh

# Copy everything
COPY . .

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Build with error tolerance
RUN cd pkg/platform && \
    npm run switch:prod || true && \
    rm -rf ./dist || true && \
    npx tsc --project tsconfig.server.json --noEmitOnError false || true && \
    npx tsc-alias -p tsconfig.server.json || true

RUN cd app/platform && \
    pnpm run build || true

EXPOSE 3000

# Start directly with Next.js
CMD ["pnpm", "--filter=./app/platform", "start"]