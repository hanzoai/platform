+						</div>
+						<div>
+							<h3 className="text-sm font-semibold">Environment Variables</h3>
+							<ul className="list-disc pl-5">
+								{templateInfo?.details?.envVariables.map(
+									(
+										env: {
+											name: string;
+											value: string;
+										},
+										index: number,
+									) => (
+										<li key={index}>
+											<strong className="text-sm font-semibold">
+												{env.name}
